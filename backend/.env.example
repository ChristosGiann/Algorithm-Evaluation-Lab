DJANGO_SECRET_KEY=replace-with-a-local-secret
DJANGO_DEBUG=True

# Optional: PostgreSQL URL from your provider; leave unset for local SQLite.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

DJANGO_ENV=development
# Production additionally requires explicit DJANGO_ALLOWED_HOSTS and
# DJANGO_CORS_ALLOWED_ORIGINS (HTTPS), strong DJANGO_SECRET_KEY and DATABASE_URL.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-frontend.example
